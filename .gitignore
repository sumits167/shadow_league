# Root GitIgnore for ShadowLeague Monorepo

# Environment variables & secrets (Never commit!)
.env
.env.*
*.env
**/.env
**/.env.*
!.env.example
!**/.env.example

# Dependencies
node_modules/
**/node_modules/

# Production Builds
dist/
**/dist/
build/
**/build/
.next/
out/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Editor & OS files
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
